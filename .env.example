# Copy this file to .env to point a local checkout at a different Firebase
# project. Get the values from Firebase Console -> Project settings ->
# Your apps -> SDK setup and configuration -> Config.
#
# Leave a variable unset to keep the live project (delegate-alumni-hpair).
# .env is gitignored; never commit real values for a project you care about.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
